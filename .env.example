# PostgreSQL Database connection string (Supabase, Neon, or local PostgreSQL)
# For the 1-command local setup (docker compose), use:
#   postgres://postgres:postgrespassword@localhost:5432/zedarchive
DATABASE_URL="postgres://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Better Auth Secret (Generate a random 32+ character string)
BETTER_AUTH_SECRET="generate-a-32-character-random-secret-key"

# Better Auth URL (Local development or Production URL)
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated trusted origins for Better Auth (Optional)
BETTER_AUTH_TRUSTED_ORIGINS=""

# Public App URL for client-side API requests
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email (Resend) - Optional
RESEND_API_KEY=""
EMAIL_FROM="ZedArchive <noreply@zedarchive.com>"

# TMDB Movie Search & Metadata (Free API token from themoviedb.org) - Optional
TMDB_API_READ_TOKEN=""
# Or legacy v3 API key:
# TMDB_API_KEY=""

# Demo seed credentials (src/db/seed.ts) - Optional
# DEMO_EMAIL="demo@zedarchive.com"
# DEMO_PASSWORD="password123"

# End-to-End Testing (Playwright) - Optional
# Playwright starts its own dev server on port 8787 by default.
# Set E2E_BASE_URL to test an already-running server instead.
# E2E_PORT="8787"
# E2E_BASE_URL="http://localhost:8787"
# Path to a system Chromium binary (CI/minimal environments):
# PW_EXECUTABLE=""
