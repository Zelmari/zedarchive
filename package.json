{
  "name": "zedarchive",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-development-anime-catalogue.ts",
    "db:seed:check": "tsx scripts/seed-development-anime-catalogue.ts --check",
    "catalogue:import:wikidata": "tsx scripts/wikidata-anime-import.ts",
    "catalogue:import:wikidata:check": "tsx scripts/wikidata-anime-import.ts check",
    "catalogue:release:prepare": "tsx scripts/wikidata-anime-release-prepare.ts",
    "catalogue:release:check": "tsx scripts/release-anime-catalogue.ts check",
    "catalogue:release:plan": "tsx scripts/release-anime-catalogue.ts plan",
    "catalogue:release:rehearse": "tsx scripts/release-anime-catalogue.ts rehearse",
    "catalogue:release:apply": "tsx scripts/release-anime-catalogue.ts apply",
    "auth:email:smoke": "node --conditions=react-server --import tsx scripts/smoke-auth-email-delivery.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test --config playwright.release-critical.config.ts",
    "test:browser:critical": "playwright test --config playwright.release-critical.config.ts",
    "test:browser:critical:helpers": "node --test tests/browser-release-critical/fixtures/hibp-fetch-redirect.test.mjs && node --import tsx --test --test-concurrency=1 tests/browser-release-critical/fixtures/account-lifecycle-rate-limit.test.ts tests/browser-release-critical/fixtures/archive-backup-auditor.test.ts tests/browser-release-critical/fixtures/artifact-audit.test.ts tests/browser-release-critical/fixtures/controlled-failure.test.ts tests/browser-release-critical/fixtures/diagnostic-manifest.test.ts tests/browser-release-critical/fixtures/loopback-auth-collectors.test.ts tests/browser-release-critical/fixtures/privacy-artifact-reporter.test.ts tests/browser-operational/account-purge/operational-reporter.test.ts tests/browser-operational/account-purge/purge-response-auditor.test.ts",
    "test:operational:account-purge": "playwright test --config playwright.account-purge-operational.config.ts",
    "test:browser:extended": "RESEND_BASE_URL=http://127.0.0.1:43132 playwright test --config playwright.config.ts",
    "test:browser:release": "playwright test --config playwright.release-catalogue.config.ts",
    "test:browser:headed": "playwright test --config playwright.release-critical.config.ts --headed",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "1.6.23",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "postcss": "^8.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "6.17.2",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
